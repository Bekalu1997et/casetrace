# Planned settings contract; implemented in Phase 1 (not loaded by an app yet).
# Relative paths resolve against CASETRACE_ROOT, never the process working directory.
# Optional absolute override; otherwise derive repository root from config module.
# CASETRACE_ROOT=C:/Users/HP/casetrace
DATABASE_URL=sqlite+aiosqlite:///./data/runtime/casetrace.db
SQLITE_BUSY_TIMEOUT_MS=5000
ASSET_STORAGE_PATH=./data/assets
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
# Configure provider and secret locally when the provider is selected.
# LLM_PROVIDER=
# LLM_API_KEY=
