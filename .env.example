# Shared backend settings; copy to .env at repository root.
# Relative paths resolve against CASETRACE_ROOT, never the process working directory.
# Optional absolute override; otherwise derive repository root from config module.
# CASETRACE_ROOT=C:/Users/HP/casetrace
DATABASE_URL=sqlite+aiosqlite:///./data/runtime/casetrace.db
SQLITE_BUSY_TIMEOUT_MS=5000
ASSET_STORAGE_PATH=./data/assets
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
LOG_LEVEL=INFO
# Copy the public API value to apps/web/.env.local for local development.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Explicit rules mode performs no LLM inference. Set gemini plus model/key for live proposals.
LLM_PROVIDER=rules
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
LLM_MAX_OUTPUT_TOKENS=4000
INVESTIGATION_TIMEOUT_SECONDS=180
INVESTIGATION_MAX_TOOL_CALLS=100
INVESTIGATION_MAX_CALLS_PER_AGENT=30
INVESTIGATION_MAX_CONTEXT_CHARS=100000
