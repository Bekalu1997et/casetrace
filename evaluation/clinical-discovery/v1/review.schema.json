{
  "$defs": {
    "Judgment": {
      "additionalProperties": false,
      "properties": {
        "finding_key": {
          "title": "Finding Key",
          "type": "string"
        },
        "finding_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Finding Ids",
          "type": "array"
        },
        "linked_relationship": {
          "minLength": 1,
          "title": "Linked Relationship",
          "type": "string"
        },
        "link_claim_finding_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Link Claim Finding Id"
        },
        "source_roles": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Source Roles",
          "type": "object"
        },
        "decisions": {
          "additionalProperties": {
            "enum": [
              "pass",
              "fail",
              "review"
            ],
            "type": "string"
          },
          "title": "Decisions",
          "type": "object"
        },
        "rationale": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Rationale",
          "type": "object"
        }
      },
      "required": [
        "finding_key",
        "finding_ids",
        "linked_relationship",
        "source_roles",
        "decisions",
        "rationale"
      ],
      "title": "Judgment",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "1.0",
      "title": "Version",
      "type": "string"
    },
    "report_sha256": {
      "title": "Report Sha256",
      "type": "string"
    },
    "spec_sha256": {
      "title": "Spec Sha256",
      "type": "string"
    },
    "case_sha256": {
      "title": "Case Sha256",
      "type": "string"
    },
    "reviewer": {
      "minLength": 1,
      "title": "Reviewer",
      "type": "string"
    },
    "qualification": {
      "minLength": 1,
      "title": "Qualification",
      "type": "string"
    },
    "reviewed_at": {
      "minLength": 1,
      "title": "Reviewed At",
      "type": "string"
    },
    "judgments": {
      "items": {
        "$ref": "#/$defs/Judgment"
      },
      "title": "Judgments",
      "type": "array"
    }
  },
  "required": [
    "version",
    "report_sha256",
    "spec_sha256",
    "case_sha256",
    "reviewer",
    "qualification",
    "reviewed_at",
    "judgments"
  ],
  "title": "Review",
  "type": "object"
}
